@model IEnumerable<OnlineStore.Models.ApplicationUser>

@{
    ViewBag.Title = "Manage Users";
}

<h2>Manage Users</h2>

<table class="table">
    <tr>
        <th>
            User Name
        </th>
        <th>
            Email
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
        </tr>
    }
</table>